# Copy to keystore.properties (same folder) and fill in. keystore.properties and the .jks file must never go into git.
# Make the key once with:  keytool -genkey -v -keystore little-legends-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=../little-legends-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
